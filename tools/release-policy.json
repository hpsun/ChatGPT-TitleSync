  "source_rules": [
    {
      "name": "csharp-default-two-seconds",
      "path": "windows/csharp/App.cs",
      "pattern": "ChatGptTitlePollMilliseconds\\s*=\\s*2000\\b"
    },
    {
      "name": "csharp-cli-default-two-seconds",
      "path": "windows/csharp/App.cs",
      "pattern": "Arg\\(args,\\s*\"--interval\",\\s*\"2\"\\)"
    },
    {
      "name": "csharp-foreground",
      "path": "windows/csharp/TitleMonitor.cs",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "python-default-two-seconds",
      "path": "windows/python/chatgpt_window_titles.py",
      "pattern": "add_argument\\(\"--interval\".{0,80}?default\\s*=\\s*2\\b"
    },
    {
      "name": "python-foreground",
      "path": "windows/python/chatgpt_window_titles.py",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "powershell-default-two-seconds",
      "path": "windows/powershell/ChatGPT-TitleSync.ps1",
      "pattern": "IntervalSeconds\\s*=\\s*2\\b"
    },
    {
      "name": "powershell-foreground",
      "path": "windows/powershell/ChatGPT-TitleSync.ps1",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "ahk-basic-default-two-seconds",
      "path": "windows/ahk-v1.0/chatgpt_window_titles_basic.ahk",
      "pattern": "^Interval\\s*:=\\s*2\\s*$"
    },
    {
      "name": "ahk-basic-foreground",
      "path": "windows/ahk-v1.0/chatgpt_window_titles_basic.ahk",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "ahk-v1.1-default-two-seconds",
      "path": "windows/ahk-v1.1/chatgpt_window_titles.ahk",
      "pattern": "Arg\\(\"--interval\",\\s*\"2\"\\)"
    },
    {
      "name": "ahk-v1.1-foreground",
      "path": "windows/ahk-v1.1/chatgpt_window_titles.ahk",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "ahk-v2-default-two-seconds",
      "path": "windows/ahk-v2/chatgpt_window_titles.ahk",
      "pattern": "Arg\\(\"--interval\",\\s*\"2\"\\)"
    },
    {
      "name": "ahk-v2-foreground",
      "path": "windows/ahk-v2/chatgpt_window_titles.ahk",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "go-default-two-seconds",
      "path": "go/settings.go",
      "pattern": "const\\s+defaultForegroundSeconds\\s*=\\s*2\\b"
    },
    {
      "name": "go-foreground",
      "path": "go/platform_windows.go",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "rust-default-two-seconds",
      "path": "rust/src/settings.rs",
      "pattern": "pub const DEFAULT_FOREGROUND:\\s*u64\\s*=\\s*2\\b"
    },
    {
      "name": "rust-foreground",
      "path": "rust/src/windows.rs",
      "pattern": "GetForegroundWindow"
    },
    {
      "name": "swift-default-two-seconds",
      "path": "macos/ChatGPTWindowTitles.swift",
      "pattern": "var\\s+interval:\\s*TimeInterval\\s*=\\s*\\{.{0,900}?return\\s+TimeInterval\\(\\(1\\.\\.\\.3600\\)\\.contains\\(saved\\)\\s*\\?\\s*saved\\s*:\\s*2\\)"
    },
    {
      "name": "objc-default-two-seconds",
      "path": "macos/ChatGPTWindowTitles.m",
      "pattern": "_interval\\s*=\\s*2\\b"
    },
    {
      "name": "go-mac-focused-application",
      "path": "go/platform_darwin.go",
      "pattern": "FocusedApplication"
    },
    {
      "name": "go-mac-focused-window",
      "path": "go/platform_darwin.go",
      "pattern": "FocusedWindow"
    },
    {
      "name": "go-mac-native-front-app-first",
      "path": "go/platform_darwin.go",
      "pattern": "frontmostApplication"
    },
    {
      "name": "rust-mac-focused-application",
      "path": "rust/src/macos.rs",
      "pattern": "FocusedApplication"
    },
    {
      "name": "rust-mac-focused-window",
      "path": "rust/src/macos.rs",
      "pattern": "FocusedWindow"
    },
    {
      "name": "rust-mac-native-front-app-first",
      "path": "rust/src/macos.rs",
      "pattern": "frontmostApplication"
    },
    {
      "name": "swift-mac-focused-application",
      "path": "macos/ChatGPTWindowTitles.swift",
      "pattern": "FocusedApplication"
    },
    {
      "name": "swift-mac-focused-window",
      "path": "macos/ChatGPTWindowTitles.swift",
      "pattern": "FocusedWindow"
    },
    {
      "name": "swift-mac-native-front-app-first",
      "path": "macos/ChatGPTWindowTitles.swift",
      "pattern": "frontmostApplication"
    },
    {
      "name": "objc-mac-focused-application",
      "path": "macos/ChatGPTWindowTitles.m",
      "pattern": "FocusedApplication"
    },
    {
      "name": "objc-mac-focused-window",
      "path": "macos/ChatGPTWindowTitles.m",
      "pattern": "FocusedWindow"
    },
    {
      "name": "objc-mac-native-front-app-first",
      "path": "macos/ChatGPTWindowTitles.m",
      "pattern": "frontmostApplication"
    },
    {
      "name": "csharp-background-default5",
      "path": "windows/csharp/App.cs",
      "pattern": "ChatGptTitleBackgroundRefreshSeconds\\s*=\\s*5\\b"
    },
    {
      "name": "python-background-default5",
      "path": "windows/python/chatgpt_window_titles.py",
      "pattern": "add_argument\\(\"--background-interval\".{0,80}?default\\s*=\\s*5\\b"
    },
    {
      "name": "powershell-background-default5",
      "path": "windows/powershell/ChatGPT-TitleSync.ps1",
      "pattern": "BackgroundIntervalSeconds\\s*=\\s*5\\b"
    },
    {
      "name": "go-background-default5",
      "path": "go/settings.go",
      "pattern": "const\\s+defaultBackgroundSeconds\\s*=\\s*5\\b"
    },
    {
      "name": "rust-background-default5",
      "path": "rust/src/settings.rs",
      "pattern": "pub const DEFAULT_BACKGROUND:\\s*u64\\s*=\\s*5\\b"
    },
    {
      "name": "swift-background-default5",
      "path": "macos/ChatGPTWindowTitles.swift",
      "pattern": "var\\s+backgroundInterval:\\s*TimeInterval\\s*=\\s*\\{.{0,900}?return\\s+TimeInterval\\(\\(5\\.\\.\\.3600\\)\\.contains\\(saved\\)\\s*\\?\\s*saved\\s*:\\s*5\\)"
    },
    {
      "name": "objc-background-default5",
      "path": "macos/ChatGPTWindowTitles.m",
      "pattern": "_backgroundInterval\\s*=\\s*5\\b"
    },
    {
      "name": "ahk-basic-background-default5",
      "path": "windows/ahk-v1.0/chatgpt_window_titles_basic.ahk",
      "pattern": "^BackgroundInterval\\s*:=\\s*5\\s*$"
    },
    {
      "name": "ahk11-background-default5",
      "path": "windows/ahk-v1.1/chatgpt_window_titles.ahk",
      "pattern": "Arg\\(\"--background-interval\",\\s*\"5\"\\)"
    },
    {
      "name": "ahk2-background-default5",
      "path": "windows/ahk-v2/chatgpt_window_titles.ahk",
      "pattern": "Arg\\(\"--background-interval\",\\s*\"5\"\\)"
    },
    {
      "name": "go-live-settings-range",
      "path": "go/settings.go",
      "pattern": "ForegroundSeconds\\s*<\\s*1.{0,180}?BackgroundSeconds\\s*<\\s*5"
    },
    {
      "name": "go-windows-native-tray-settings",
      "path": "go/tray_windows.go",
      "pattern": "Shell_NotifyIconW.{0,10000}?扫描间隔设置"
    },
    {
      "name": "go-macos-public-menu-companion",
      "path": "go/tray_darwin.go",
      "pattern": "TraySettings\\.applescript.{0,3000}?/usr/bin/osascript"
    },
    {
      "name": "rust-live-settings-range",
      "path": "rust/src/settings.rs",
      "pattern": "\\(1\\.\\.=3600\\).{0,100}?\\(5\\.\\.=3600\\)"
    },
    {
      "name": "rust-windows-native-tray-settings",
      "path": "rust/src/tray_windows.rs",
      "pattern": "Shell_NotifyIconW.{0,20000}?扫描间隔设置"
    },
    {
      "name": "rust-macos-public-menu-companion",
      "path": "rust/src/tray_macos.rs",
      "pattern": "TraySettings\\.applescript.{0,3000}?/usr/bin/osascript"
    },
    {
      "name": "public-macos-menu-settings-save",
      "path": "macos/TraySettings.applescript",
      "pattern": "on saveSettings:sender.{0,1800}?persistValues"
    },
    {
      "name": "csharp-menu-settings-handler",
      "path": "windows/csharp/App.cs",
      "pattern": "Scan intervals.{0,3000}?ScanSettings\\.Apply"
    },
    {
      "name": "powershell-menu-settings-handler",
      "path": "windows/powershell/ChatGPT-TitleSync.ps1",
      "pattern": "function Initialize-CgtTray.{0,2600}?扫描间隔设置"
    },
    {
      "name": "go-cli-default-constant-bindings",
      "path": "go/main.go",
      "pattern": "Int\\(\"background-interval\",\\s*defaultBackgroundSeconds.{0,800}?Int\\(\"interval\",\\s*defaultForegroundSeconds"
    },
    {
      "name": "rust-cli-default-constant-bindings",
      "path": "rust/src/main.rs",
      "pattern": "let interval\\b.{0,700}?settings::DEFAULT_FOREGROUND.{0,800}?let background\\b.{0,700}?settings::DEFAULT_BACKGROUND"
    }
  ],
  "notes": [
    "No runtime SDK, binary, execution log, validation artifact, snapshot, backup or private JSON is part of the source package.",
    "Static source markers are review checks, not runtime acceptance tests.",
    "Adding a public file requires an explicit policy review.",
    "Local source candidate has controlled Windows protocol checks; macOS remains Experimental/uncompiled. User approval on 2026-11-11 authorizes the root publisher; audit success alone never grants authorization.",
    "Targeted Windows settings/caption-repair receipts supplement controlled checks; they do not imply native Mac, physical shell click, installation, long-term acceptance or publication approval.",
    "User explicitly requested normal repository directory/file publication, not a project ZIP upload; GitHub automatic source archives are platform-generated."
  ],
